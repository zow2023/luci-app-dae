#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

extra_command "hot_reload" "Hot-reload service"

CONF="dae"
PROG="/usr/bin/dae"
LOG="/var/log/dae/dae.log"
DAE_HOST_IFACE="dae0"
DAE_PEER_IFACE="dae0peer"
DAE_NETNS_NAME="daens"
DAENETNS="/run/netns/$DAE_NETNS_NAME"

# Runtime-only DNS override. This file is never used as OpenWrt's native
# resolver source; it only temporarily replaces /tmp/resolv.conf.
RESOLV_SYSTEM="/tmp/resolv.conf"
RESOLV_AUTO="/tmp/resolv.conf.d/resolv.conf.auto"
RESOLV_DAE="/tmp/resolv.conf.dae"
RESOLV_ORIG="/tmp/resolv.conf.dae.orig"
RESOLV_STATE="/tmp/resolv.conf.dae.state"

set_config_permissions() {
    mkdir -p /etc/dae/config.d /var/log/dae
    find /etc/dae -type d -exec chmod 750 {} \; 2>/dev/null || true
    find /etc/dae -type f -exec chmod 640 {} \; 2>/dev/null || true
}

update_cron() {
    local temp_cron="/tmp/root.cron"

    if [ -f /etc/crontabs/root ]; then
        grep -v '/etc/init.d/dae hot_reload' /etc/crontabs/root > "$temp_cron" 2>/dev/null || true
    fi
    : >> "$temp_cron"

    local auto_update
    auto_update=$(uci -q get dae.config.subscribe_auto_update)
    if [ "$1" = "add" ] && [ "${auto_update:-0}" -eq 1 ]; then
        local min=$((RANDOM % 60))
        local hr
        local wk
        hr=$(uci -q get dae.config.subscribe_update_day_time)
        wk=$(uci -q get dae.config.subscribe_update_week_time)
        echo "$min ${hr:-*} * * ${wk:-*} /etc/init.d/dae hot_reload >/dev/null 2>&1" >> "$temp_cron"
    fi

    crontab "$temp_cron" 2>/dev/null
    rm -f "$temp_cron"
}

cleanup_netns() {
    tc qdisc del dev "$DAE_HOST_IFACE" clsact 2>/dev/null || true
    ip link del "$DAE_HOST_IFACE" 2>/dev/null || true
    ip link del "$DAE_PEER_IFACE" 2>/dev/null || true
    ip netns del "$DAE_NETNS_NAME" 2>/dev/null || true
    umount "$DAENETNS" 2>/dev/null || true
    rm -f "$DAENETNS" 2>/dev/null || true
}

is_resolv_mountpoint() {
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$RESOLV_SYSTEM" 2>/dev/null
    else
        grep -q " $RESOLV_SYSTEM " /proc/mounts 2>/dev/null
    fi
}

cleanup_old_dns_mount() {
    local target

    # Older versions of this script could bind /tmp/resolv.conf.dae onto
    # /tmp/resolv.conf and, because that path is commonly a symlink, the
    # actual mount may have landed on its target. Remove only our own old
    # source mount if one is still present.
    target=$(awk -v src="$RESOLV_DAE" '$1 == src { print $2; exit }' /proc/mounts 2>/dev/null)
    [ -n "$target" ] || return 0

    umount "$target" 2>/dev/null || return 1
    return 0
}

restore_resolv_conf() {
    local original_type

    [ -f "$RESOLV_STATE" ] || {
        rm -f "$RESOLV_DAE" "$RESOLV_ORIG"
        return 0
    }

    if is_resolv_mountpoint; then
        mount -o remount,rw,bind "$RESOLV_SYSTEM" 2>/dev/null || true
        umount "$RESOLV_SYSTEM" 2>/dev/null || return 1
    fi

    original_type=$(cat "$RESOLV_STATE" 2>/dev/null)
    case "$original_type" in
        symlink)
            rm -f "$RESOLV_SYSTEM"
            mv -f "$RESOLV_ORIG" "$RESOLV_SYSTEM" || {
                # Last resort: restore as a symlink to the standard OpenWrt
                # resolver source.
                ln -sf "$RESOLV_AUTO" "$RESOLV_SYSTEM"
            }
            ;;
        file)
            rm -f "$RESOLV_SYSTEM"
            mv -f "$RESOLV_ORIG" "$RESOLV_SYSTEM" || return 1
            ;;
        missing)
            rm -f "$RESOLV_SYSTEM" "$RESOLV_ORIG"
            ;;
        *)
            return 1
            ;;
    esac

    rm -f "$RESOLV_DAE" "$RESOLV_STATE"
    return 0
}

prepare_resolv_override() {
    local target type

    # Never layer another override on top of an existing one.
    [ -f "$RESOLV_STATE" ] && restore_resolv_conf || true
    cleanup_old_dns_mount || return 1

    rm -f "$RESOLV_DAE" "$RESOLV_ORIG" "$RESOLV_STATE"

    if [ -L "$RESOLV_SYSTEM" ]; then
        type="symlink"
    elif [ -f "$RESOLV_SYSTEM" ]; then
        type="file"
    elif [ ! -e "$RESOLV_SYSTEM" ]; then
        type="missing"
    else
        return 1
    fi

    # Move the real OpenWrt resolver entry away before bind-mounting. This is
    # the important difference from the old implementation: if /tmp/resolv.conf
    # is a symlink, mount must NOT follow it and overwrite resolv.conf.auto.
    mv "$RESOLV_SYSTEM" "$RESOLV_ORIG" || return 1
    printf '%s\n' "$type" > "$RESOLV_STATE" || {
        mv "$RESOLV_ORIG" "$RESOLV_SYSTEM"
        return 1
    }

    : > "$RESOLV_SYSTEM" || {
        mv "$RESOLV_ORIG" "$RESOLV_SYSTEM"
        rm -f "$RESOLV_STATE"
        return 1
    }

    return 0
}

build_resolv_file() {
    local dns_list="$1"
    local dns
    local count=0

    : > "$RESOLV_DAE" || return 1

    # Preserve resolver metadata only. Never copy the native nameserver lines;
    # the runtime nameservers are explicitly supplied by resolv_dns.
    if [ -f "$RESOLV_ORIG" ]; then
        sed -n \
            '/^[[:space:]]*search[[:space:]]/p;\
             /^[[:space:]]*domain[[:space:]]/p;\
             /^[[:space:]]*options[[:space:]]/p' \
            "$RESOLV_ORIG" >> "$RESOLV_DAE" 2>/dev/null || true
    elif [ "$(cat "$RESOLV_STATE" 2>/dev/null)" = "symlink" ]; then
        target=$(readlink "$RESOLV_ORIG" 2>/dev/null)
        case "$target" in
            /*) : ;;
            *) target="$(dirname "$RESOLV_ORIG")/$target" ;;
        esac
        [ -r "$target" ] && sed -n \
            '/^[[:space:]]*search[[:space:]]/p;\
             /^[[:space:]]*domain[[:space:]]/p;\
             /^[[:space:]]*options[[:space:]]/p' \
            "$target" >> "$RESOLV_DAE" 2>/dev/null || true
    fi

    for dns in $dns_list; do
        [ -n "$dns" ] || continue
        printf 'nameserver %s\n' "$dns" >> "$RESOLV_DAE"
        count=$((count + 1))
    done

    [ "$count" -gt 0 ] || return 1
    chmod 644 "$RESOLV_DAE"
    return 0
}

install_resolv_override() {
    local dns_list="$1"

    [ -n "$dns_list" ] || return 1
    prepare_resolv_override || return 1

    if ! build_resolv_file "$dns_list"; then
        restore_resolv_conf || true
        return 1
    fi

    if ! mount --bind "$RESOLV_DAE" "$RESOLV_SYSTEM" 2>/dev/null; then
        restore_resolv_conf || true
        return 1
    fi

    mount -o remount,ro,bind "$RESOLV_SYSTEM" 2>/dev/null || true
    return 0
}

start_service() {
    local enabled config_file log_maxbackups log_maxsize dns_list

    config_load "$CONF"
    config_get_bool enabled "config" "enabled" "0"
    [ "$enabled" -eq 1 ] || return 1

    config_get config_file "config" "config_file" "/etc/dae/config.dae"
    config_get log_maxbackups "config" "log_maxbackups" "1"
    config_get log_maxsize "config" "log_maxsize" "1"
    config_get dns_list "config" "resolv_dns" ""

    set_config_permissions
    "$PROG" validate -c "$config_file" || return 1

    cleanup_old_dns_mount || return 1
    cleanup_netns

    # resolv_dns is optional. Without it, OpenWrt's native resolver is left
    # completely untouched.
    if [ -n "$dns_list" ]; then
        install_resolv_override "$dns_list" || return 1
    else
        restore_resolv_conf || return 1
    fi

    update_cron add

    procd_open_instance "$CONF"
    uname -r | grep -Eq '^6\.6' && procd_set_param env QUIC_GO_DISABLE_GSO=true
    procd_set_param env DAE_LOCATION_ASSET=/usr/share/v2ray
    procd_set_param command "$PROG" run
    procd_append_param command --config "$config_file"
    procd_append_param command --disable-timestamp
    procd_append_param command --logfile "$LOG"
    procd_append_param command --logfile-maxbackups "$log_maxbackups"
    procd_append_param command --logfile-maxsize "$log_maxsize"
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    update_cron remove
}

service_stopped() {
    restore_resolv_conf || true
    cleanup_netns
}

reload_service() {
    /etc/init.d/dae stop
    /etc/init.d/dae start
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

hot_reload() {
    set_config_permissions
    /etc/init.d/dae running && "$PROG" reload
}
